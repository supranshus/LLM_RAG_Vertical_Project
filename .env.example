# "mock" reads JSON from mock_data/, "api" calls the real backend.
DATA_SOURCE=mock

# Used only when DATA_SOURCE=api
API_BASE_URL=http://localhost:8000/api
API_TOKEN=
API_TIMEOUT=15

# Simulated latency for mock mode (ms), handy for testing spinners.
MOCK_LATENCY_MS=0

# Cache TTL for data fetched through services (seconds). 0 disables caching.
CACHE_TTL=60
