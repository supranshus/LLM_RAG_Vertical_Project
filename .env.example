# Copy to .env and fill in. Both apps read this file (backend/ and frontend/ look one level up).
# Never commit .env.

# ---- Microsoft Entra ID (see README: "Entra app registration") ----
# Directory (tenant) ID of your organisation.
ENTRA_TENANT_ID=
# Application (client) ID of the app registration.
ENTRA_CLIENT_ID=
# Client secret value (frontend only; used to complete sign-in).
ENTRA_CLIENT_SECRET=
# The API scope the frontend asks for, e.g. api://<client-id>/access_as_user
ENTRA_API_SCOPE=api://<client-id>/access_as_user
# The scope name alone (API side). The API refuses tokens that don't carry it.
ENTRA_REQUIRED_SCOPE=access_as_user
# Where Microsoft sends users back after sign-in; must match the registration exactly.
ENTRA_REDIRECT_URI=http://localhost:8501

# ---- Frontend ----
# Where Streamlit reaches the API (docker compose overrides this to http://backend:8000).
API_BASE_URL=http://localhost:8000

# ---- Database ----
# SQLite file by default. For Postgres: postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./data/app.db

# ---- LLM ----
# Provider key from the LLM factory (groq is built in).
LLM_PROVIDER=groq
# Groq model names change over time; check https://console.groq.com/docs/models
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60

# ---- Chat ----
CHAT_SYSTEM_PROMPT=You are a helpful assistant.
# How many earlier messages are sent to the model with each new one.
CHAT_HISTORY_LIMIT=20

# ---- Document Q&A (Pinecone) ----
VECTOR_STORE_PROVIDER=pinecone
EMBEDDING_PROVIDER=pinecone
PINECONE_API_KEY=pcsk_4o3Bv4_9o1YFSMqBXNVo4iSpyH2ARvkcTxbERpbL2Bjpsrac9WqUBjTtRuBVqqPgV7JEjA
# Use a different index name for each app built from this boilerplate.
PINECONE_INDEX_NAME=genai-boilerplate
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
EMBEDDING_MODEL=multilingual-e5-large
EMBEDDING_DIMENSION=1024
# Passages returned per question, and the minimum similarity to count as a match.
RAG_TOP_K=5
RAG_MIN_SCORE=0.78
# Chunk size and overlap in characters.
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
# Upload limit in MB (keep frontend/.streamlit/config.toml maxUploadSize in step).
MAX_UPLOAD_MB=10
UPLOAD_DIR=./data/uploads

# ---- Logging ----
LOG_LEVEL=INFO
LOG_DIR=./logs
# Daily log files kept before deletion.
LOG_RETENTION_DAYS=14
